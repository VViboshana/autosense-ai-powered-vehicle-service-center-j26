# API settings shared by the whole team. This file IS committed: never put a password or key in it.
# Secrets and personal overrides go in backend/.env.local (not committed); its values win over this file.
# Every setting is checked at startup; a wrong value stops the API with a message naming it.

NODE_ENV=development
PORT=5000

# The database address (DATABASE_URL) contains a password, so it lives in backend/.env.local:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/autosense?sslmode=verify-full
# Most connections the API keeps open (Neon's free tier is fine with the default).
DATABASE_POOL_MAX=10

# Web addresses of the web app, comma-separated. Changes (sign-in, saves) are only accepted from these.
# Running on other ports? Override it in .env.local, e.g. ALLOWED_ORIGINS=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173

# AI services (FastAPI). Leave as they are when the services run on this machine.
ML_DAMAGE_URL=http://localhost:8001
ML_OCCUPANCY_URL=http://localhost:8002

# debug | info | warn | error
LOG_LEVEL=info

# On a server other people can reach, put SETUP_KEY=<long random key> in .env.local (never here): the first-run
# setup page then asks for it before creating the first administrator.
