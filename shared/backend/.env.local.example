# Copy to .env.local (never committed) and fill in. Values here override backend/.env.
# The team's database: ask the team lead privately for the connection string, or use your own Neon branch's.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/autosense?sslmode=verify-full

# Optional personal overrides, e.g. when running a second copy of the app beside another:
# PORT=5001
# ALLOWED_ORIGINS=http://localhost:5174
