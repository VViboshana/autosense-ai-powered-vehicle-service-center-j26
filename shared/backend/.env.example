# Copy to .env (never commit .env). Every setting is checked at startup; a wrong value stops the API with a clear message.

NODE_ENV=development
PORT=5000

# PostgreSQL. The team's Neon database: ask the team lead for the connection string (end it with ?sslmode=verify-full; remove &channel_binding=require).
# Local PostgreSQL also works: postgres://postgres:postgres@localhost:5432/autosense
DATABASE_URL=postgres://USER:PASSWORD@HOST/autosense?sslmode=verify-full
# Most connections the API keeps open (Neon's free tier is fine with the default).
DATABASE_POOL_MAX=10

# Web addresses of the web app, comma-separated. Changes (sign-in, saves) are only accepted from these.
# Add yours if you run the web app on another port, e.g. http://localhost:5173,http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173

# Optional. The first time the app runs (no staff accounts yet) it shows "Set up AutoSense" to create the first
# administrator. Set a key here on any server other people can reach; the setup page will then ask for it.
# SETUP_KEY=choose-a-long-random-key

# AI services (FastAPI). Leave as they are when the services run on this machine.
ML_DAMAGE_URL=http://localhost:8001
ML_OCCUPANCY_URL=http://localhost:8002

# debug | info | warn | error
LOG_LEVEL=info
